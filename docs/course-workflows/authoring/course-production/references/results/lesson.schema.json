{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "draft",
    "files"
  ],
  "properties": {
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "materialIndexes": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "objectives": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "prerequisites": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "misconceptions": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "minutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 360
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "teacherAction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "learnerAction": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "checkForUnderstanding": {
                "type": "string",
                "maxLength": 10000,
                "description": "Use an empty string when absent; Host normalizes absence."
              }
            }
          }
        },
        "examples": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "exercises": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "visualRequests": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "notes": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 0,
      "maxItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "path"
        ],
        "properties": {
          "format": {
            "enum": [
              "tex",
              "rmd"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Author-chosen new artifact filename beneath sources/, relative to the task workspace; no absolute path, traversal, or context-resource path. Host captures its SHA256/bytes; supply exactly one of path or legacy source."
          },
          "documentKind": {
            "enum": [
              "beamer",
              "teacher-notes",
              "assignment"
            ]
          },
          "role": {
            "enum": [
              "student",
              "solution"
            ]
          },
          "outputMode": {
            "enum": [
              "knit",
              "render"
            ]
          },
          "expectedPages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      }
    }
  }
}
